# Docker Compose local defaults. Generate different random hex values for both secrets.
POSTGRES_PASSWORD=replace-with-random-hex
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
APP_ENV=development
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
PUBLIC_FRONTEND_URL=http://localhost:8080
