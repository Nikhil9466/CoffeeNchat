APP_ENV=development
SQLALCHEMY_DATABASE_URL=postgresql://postgres:password@localhost:5432/coffeenchat
JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRE_MINUTES=30
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional email recovery (STARTTLS required):
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_FROM=CoffeeNchat <hello@example.com>
# SMTP_USER=
# SMTP_PASSWORD=
# PUBLIC_FRONTEND_URL=https://chat.example.com
